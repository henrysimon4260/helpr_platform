# Server-only. Do not prefix these with NEXT_PUBLIC_.
# The browser talks to /api/support-chat and never sees the model key.

# Preferred path: proxy the website chat to the deployed support-chat function.
SUPABASE_URL=https://hecikcopbdhhiilhgmrd.supabase.co
SUPABASE_ANON_KEY=

# Used only when SUPABASE_URL and SUPABASE_ANON_KEY are not both set.
OPENAI_API_KEY=

# Contact form and chat escalation email. If any required SMTP value is
# missing, the site says the email was not sent.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_SECURE=false
SUPPORT_INBOX_EMAIL=henry@helprservices.co
