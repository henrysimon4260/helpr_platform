EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=your-google-key
EXPO_PUBLIC_OPENAI_API_KEY=your-openai-key

# Google sign-in ID tokens (optional). When unset, login uses Supabase's Google OAuth browser flow.
# Create these in Google Cloud, then add the same client IDs under Supabase Auth > Providers > Google.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
